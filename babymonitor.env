# Baby Monitor - podman launcher settings
#
# Copy this file to ~/podman/babymonitor.env (or wherever ENV_FILE points
# in babymonitor.sh) and edit as needed. Every value below is already the
# built-in default in babymonitor.sh, so this file is entirely optional -
# it's only picked up if it exists, and only overrides what you uncomment.
#
# Note: this only configures how the container/pod is launched. The app
# itself (baby profile, reminder intervals, session windows, etc.) is
# configured from its own Settings tab after it's running.

# Host port the app is exposed on (APP_PORT:8000 inside the container)
APP_PORT=8000

# Pod/image naming
POD_NAME=babymonitor
IMAGE=babymonitor:latest

# Timezone inside the container. babymonitor.sh auto-detects this from
# /etc/timezone; uncomment to force a specific value instead.
#TZ=UTC

# Where the babymonitor repo/checkout lives, used to build the image from
# (must contain Containerfile). Defaults to ~/babymonitor - only set this
# if you clone it somewhere else.
#REPO_PATH=$HOME/babymonitor

# Where the SQLite database and app data are persisted on the host.
# This file is bash-sourced, so $HOME expands to whichever user runs the
# script - only replace it if you want a fixed, non-$HOME-relative path.
DATA_DIR=$HOME/podman_data/babymonitor

# Contact address sent to push services (Google/Apple/Mozilla) with every
# push notification, as a mailto: or https: URI. Only needed if a push
# service rejects the built-in placeholder - set it to a real address.
#VAPID_SUBJECT=mailto:you@example.com
